<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy.

  Cleartext HTTP is disabled everywhere: every source is fetched over HTTPS and an APK
  must never arrive over an unencrypted connection where it could be swapped in transit.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
