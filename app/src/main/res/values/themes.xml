<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- Base application theme. -->
  <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
    <!-- Edge-to-edge is enforced on API 35+: pick dark/light system bar icons to match the theme. -->
    <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
  </style>

  <style name="AppTheme" parent="Base.AppTheme" />

  <!--
    Shown while the process starts, before Compose takes over. Uses the brand dark
    charcoal so the launch is seamless in both modes without relying on the splash API.
  -->
  <style name="Theme.Aprax.Starting" parent="Base.AppTheme">
    <item name="android:windowBackground">@color/aprax_splash_background</item>
  </style>
</resources>
