<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- Base application theme. Compose supplies the visual theme; this XML theme only
       configures the pre-Compose window, so it uses a platform parent and needs no
       Material Components (Views) dependency. -->
  <style name="Base.AppTheme" parent="@android:style/Theme.Material.NoActionBar">
    <!-- Edge-to-edge is enforced on API 35+: pick dark/light system bar icons to match the theme. -->
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
  </style>

  <style name="AppTheme" parent="Base.AppTheme" />

  <!--
    Shown while the process starts, before Compose takes over. Uses the brand dark
    charcoal so the launch is seamless in both modes without relying on the splash API.
  -->
  <style name="Theme.Aprax.Starting" parent="Base.AppTheme">
    <item name="android:windowBackground">@color/aprax_splash_background</item>
  </style>
</resources>
