<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy launcher icon (API 24-25). API 26+ prefers the adaptive icon in
  mipmap-anydpi-v26; this layer-list is only reached on older devices and
  stacks the same background and foreground vectors the adaptive icon uses.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
