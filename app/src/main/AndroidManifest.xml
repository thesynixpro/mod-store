<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reading partner sites. The app talks to source websites only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Requesting installs is the only way to hand a downloaded APK to Android's
      PackageInstaller. The permission does NOT grant silent install: it merely lets the
      app ask, and the user still confirms through Android's own dialog. The app never
      bypasses or suppresses that dialog.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Foreground service used while a download is in flight, so it is not killed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Progress notifications for downloads. Requested at runtime on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Downloading only works over HTTPS. The app deliberately does not enable cleartext
      traffic, so a source that only offers HTTP cannot be used for downloads.
    -->
    <application
        android:name=".ApraxApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aprax.Starting"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Aprax.Starting"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Accepts a source page link from a browser so a shared listing can be opened
              directly in the app. Only the three known source hosts are matched.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="modyolo.com" />
                <data android:scheme="https" android:host="www.modyolo.com" />
            </intent-filter>
        </activity>

        <!--
          PackageInstaller results come back through a PendingIntent targeting this
          receiver, so the app can tell the user whether installation succeeded. It is not
          exported and does nothing but update local state.
        -->
        <receiver
            android:name="com.aprax.modstore.data.install.InstallResultReceiver"
            android:exported="false" />

        <!--
          Shares downloaded APKs with the system installer. The provider is not exported, so
          no other app can read the app's files; a content:// URI is minted per install and
          scoped to the installer by grant flags only.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.apk-provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          WorkManager is initialised on demand by Hilt so the download worker can receive
          its dependencies. Disabling the default initialiser is required for that.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>